# 应用基础配置
APP_NAME=llm-ideological-case-platform
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Docker本地业务数据库
# 三个初始化变量只供Docker Compose创建本地PostgreSQL使用
# 实际密码请写入未被Git跟踪的.env文件，并与DATABASE_URL中的账号信息保持一致
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_DB=ideological_case_platform

# FastAPI后端数据库连接
# 本机5433端口映射到容器内部的PostgreSQL 5432端口
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-local-database-password@localhost:5433/ideological_case_platform

# 跨域配置
# 多个地址使用英文逗号分隔，每个地址只包含协议、主机和端口
CORS_ORIGINS=http://localhost:5173

# 认证配置
# 必须在本地或部署环境中替换为高强度随机值
SECRET_KEY=replace-with-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120

# MaxKB服务
MAXKB_BASE_URL=http://localhost:8080
MAXKB_API_KEY=replace-with-your-maxkb-api-key
MAXKB_TIMEOUT_SECONDS=60
MAXKB_MOCK_ENABLED=true

# MaxKB应用标识
# 对应工作流发布后再填写
MAXKB_QA_APPLICATION_ID=
MAXKB_GENERATION_APPLICATION_ID=
MAXKB_EVALUATION_APPLICATION_ID=
